# Dockerfile.cpu
FROM continuumio/miniconda3:latest

WORKDIR /app

# 安装必要的系统组件 (给 psycopg2 编译用)
RUN apt-get update && apt-get install -y gcc g++ libpq-dev && rm -rf /var/lib/apt/lists/*

# 复制 CPU 配置文件
COPY environment_cpu.yml .

# 创建 Conda 环境
RUN conda env create -f environment_cpu.yml


ENV PATH=/opt/conda/envs/cssa-ai/bin:$PATH

# Download pinned model artifacts in a cacheable image layer.
COPY ops/__init__.py ops/download_models.py ./ops/
COPY app/core/__init__.py ./app/core/
COPY app/core/config ./app/core/config
RUN --mount=type=cache,target=/root/.cache/huggingface \
    python ops/download_models.py --target-dir /models

ENV MODEL_DIR=/models

# 复制你的所有代码
COPY . .

RUN groupadd --system appuser && \
    useradd --system --gid appuser --create-home appuser

ENV HOME=/home/appuser

USER appuser

# 保持容器运行
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" || exit 1

# --no-access-log disables uvicorn's plain-text per-request access log so stdout
# carries only our structured JSON access log (app/core/middleware.py), keeping
# it clean for the ECS awslogs driver -> CloudWatch.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
