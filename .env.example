ENV=dev
OPENAI_API_KEY=your_openai_api_key_here
CHAT_API_KEY=your_internal_chat_api_key_here
WECHAT_API_KEY=your_wechat_api_key_here
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>
# MODEL_DIR=./models
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# CHAT_RATE_LIMIT=10/minute
# Site-wide /chat cap shared by all clients ("day" = rolling 24h window,
# counter resets on API restart). Also pass it through docker-compose when
# tuning in production — the image contains no .env file.
# CHAT_GLOBAL_RATE_LIMIT=500/day
# Stamped onto every chat_interactions row's config fingerprint. Unset is
# fine locally (the fingerprint records null); set both in production, or
# six months of rows lose the "which code / which corpus" coordinates.
# GIT_SHA=
# CORPUS_SHA256=
