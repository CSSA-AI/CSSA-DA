# Production API image for CSSA-DA (long-running /chat service).
#
# Multi-stage build:
#   1. builder        — install the locked `api` dependency set with uv and
#                       download the pinned models. Carries uv and build-time
#                       tooling that must NOT reach the final image.
#   2. final runtime  — a clean slim base with only the virtualenv, the models
#                       and the application code, run as a non-root user.
#
# The pipeline runs from a separate image (Dockerfile.pipeline). The base image
# is pinned by digest so every build starts from the exact same layer.

# ---------------------------------------------------------------------------
# Stage 1: builder
# ---------------------------------------------------------------------------
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93 AS builder

# Pinned uv binary (by digest) from Astral's published image.
COPY --from=ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

# Shared core + `api` group only. --no-default-groups drops `dev` test tooling.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --group api

# The API needs both models: the embedding model to embed the query and the
# reranker to re-score retrieved candidates.
COPY ops/__init__.py ops/download_models.py ./ops/
COPY app/core/__init__.py ./app/core/
COPY app/core/config ./app/core/config
RUN --mount=type=cache,target=/root/.cache/huggingface \
    /app/.venv/bin/python ops/download_models.py --target-dir /models

# ---------------------------------------------------------------------------
# Stage 2: final runtime
# ---------------------------------------------------------------------------
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

RUN groupadd --system appuser && \
    useradd --system --gid appuser --create-home appuser

WORKDIR /app

COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv
COPY --from=builder --chown=appuser:appuser /models /models
COPY --chown=appuser:appuser . .

ENV PATH=/app/.venv/bin:$PATH \
    MODEL_DIR=/models \
    HOME=/home/appuser \
    HF_HOME=/home/appuser/.cache/huggingface \
    PYTHONUNBUFFERED=1

USER appuser

EXPOSE 8000

# start-period covers model preload (lifespan loads torch + both models).
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" || exit 1

# --no-access-log keeps stdout to our structured JSON logs only (app/core/middleware.py).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
